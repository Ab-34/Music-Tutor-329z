# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Any OpenRouter model id (https://openrouter.ai/models)
TUTOR_MODEL=anthropic/claude-sonnet-5.5
TUTOR_EFFORT=medium
# Spending caps (USD). The total cap is checked against llm_ledger.jsonl before every call.
TUTOR_BUDGET_USD=10
TUTOR_RUN_BUDGET_USD=0.50
# Path to a General MIDI soundfont (.sf2) for realistic synthesis
SOUNDFONT=data/soundfonts/FluidR3_GM.sf2
